#!/bin/bash
# pre-push — Busca wikilinks rotos antes de hacer push
# Ubicación: .githooks/pre-push
# v5 — Ignora: bloques código, anclas [[#...]], archivos índice, patrones regex

set -euo pipefail

echo "🔍 Verificando wikilinks antes del push..."

cd "$(git rev-parse --show-toplevel)"

# Extraer wikilinks, excluyendo:
# - Archivos índice internos (00*, Log*, Prompts*, Scripts del Vault, Templates, .obsidian)
# - Bloques de código ``` ... ```
# - Anclas [[#...]]
# - Patrones que no son wikilinks reales (regex como [[:space:]])
WIKILINKS=$(find . -name '*.md' \
    -not -path './Templates/*' \
    -not -path './.obsidian/*' \
    -not -path './.git/*' \
    -not -path './00 - Indices y Mapas/*' \
    -not -path './10 - Automatización y Scripts/Log.md' \
    -not -path './10 - Automatización y Scripts/Scripts del Vault.md' \
    -not -name 'CLAUDE.md' \
    -not -name 'README.md' \
    -not -name 'AGENTS.md' \
    -not -name 'TODO.md' \
    -not -name 'Prompts de Trabajo.md' \
    -exec sed '/^```/,/^```/d' {} + 2>/dev/null | \
    grep -oP '\[\[([^\]]+)\]\]' | \
    sed 's/\[\[//;s/\]\]//' | \
    sed 's/|.*//' | \
    sed 's/\\$//' | \
    grep -v '#' | \
    grep -v '\.\.\.' | \
    grep -v '^:' | \
    grep -v '^%' | \
    sort -u || true)

# Recolectar nombres reales de archivos (sin extensión, sin ruta)
NOTAS_EXISTENTES=$(find . -name '*.md' \
    -not -path './Templates/*' \
    -not -path './.obsidian/*' \
    -not -path './.git/*' \
    -exec basename {} .md \; || true)

# v6: en vez de un bucle `while read ... grep` (lento y no determinista por los
# miles de forks/pipe que podían colgar el hook y producir falsos positivos),
# se usa `comm -23` para obtener la diferencia de conjuntos en O(n log n).
# Se normaliza a minúsculas para mantener el matching case-insensitive previo.
ROTOS=$(comm -23 \
    <(printf '%s\n' "$WIKILINKS" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | tr '[:upper:]' '[:lower:]' | sed '/^$/d' | sort -u) \
    <(printf '%s\n' "$NOTAS_EXISTENTES" | tr '[:upper:]' '[:lower:]' | sort -u))

ERRORES=0
if [[ -n "$ROTOS" ]]; then
    while IFS= read -r roto; do
        [[ -z "$roto" ]] && continue
        echo "  ⚠️  Wikilink roto: [[${roto}]]"
        ((ERRORES++)) || true
    done <<< "$ROTOS"
fi

if [[ $ERRORES -gt 0 ]]; then
    echo ""
    echo "❌ Se encontraron $ERRORES wikilink(s) roto(s). Corrige antes de hacer push."
    exit 1
fi

echo "  ✅ Todos los wikilinks son válidos."
exit 0
