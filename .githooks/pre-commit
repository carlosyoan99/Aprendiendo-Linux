#!/bin/bash
# pre-commit — Verifica frontmatter y sincroniza fecha_modificacion en .md staged
# Ubicación: .githooks/pre-commit
# v2 — Automatiza add-modification-date.sh en los archivos staged (fecha_modificacion = hoy)

set -euo pipefail

echo "🔍 Validando frontmatter en archivos staged..."

# Obtener archivos .md staged (excluyendo Templates/, CLAUDE.md, README.md, AGENTS.md)
STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep '\.md$' | grep -v '^Templates/' | grep -v '^CLAUDE\.md$' | grep -v '^README\.md$' | grep -v '^AGENTS\.md$' || true)

if [[ -z "$STAGED" ]]; then
    exit 0
fi

ERRORES=0

while IFS= read -r archivo; do
    if [[ ! -f "$archivo" ]]; then
        continue
    fi

    PRIMERA_LINEA=$(head -1 "$archivo")
    if [[ "$PRIMERA_LINEA" != "---" ]]; then
        echo "  ❌ $archivo — Sin frontmatter (no empieza con ---)"
        ((ERRORES++)) || true
        continue
    fi

    FRONT=$(awk '/^---/{c++; next} c==1{print}' "$archivo")
    if [[ -z "$FRONT" ]]; then
        echo "  ❌ $archivo — Frontmatter sin cerrar (falta --- final)"
        ((ERRORES++)) || true
        continue
    fi

    if ! echo "$FRONT" | grep -q "^fecha_creacion:"; then
        echo "  ⚠️  $archivo — Sin fecha_creacion"
        ((ERRORES++)) || true
    fi

    if ! echo "$FRONT" | grep -q "^estado:"; then
        echo "  ⚠️  $archivo — Sin estado"
        ((ERRORES++)) || true
    fi

    if ! echo "$FRONT" | grep -q "^categoria:"; then
        echo "  ⚠️  $archivo — Sin categoria"
        ((ERRORES++)) || true
    fi
done <<< "$STAGED"

if [[ $ERRORES -gt 0 ]]; then
    echo "  ❌ $ERRORES error(es) de frontmatter. Corrige antes de commitear."
    exit 1
fi

echo "  ✅ Frontmatter válido en todos los archivos staged."

# Sincronizar fecha_modificacion = hoy en las notas staged (automatiza add-modification-date.sh)
HOY=$(date +%Y-%m-%d)
SYNCED=0
while IFS= read -r archivo; do
    [[ ! -f "$archivo" ]] && continue
    if ! grep -q '^fecha_modificacion:' "$archivo"; then
        # Añadir tras fecha_creacion
        perl -i -pe "s/^(fecha_creacion:.*)$/\$1\\nfecha_modificacion: $HOY/" "$archivo" || continue
    else
        # Actualizar la existente
        perl -i -pe "s/^fecha_modificacion:.*/fecha_modificacion: $HOY/" "$archivo" || continue
    fi
    git add -- "$archivo" 2>/dev/null || true
    ((SYNCED++)) || true
done <<< "$STAGED"

if [[ $SYNCED -gt 0 ]]; then
    echo "  🔄 fecha_modificacion → $HOY en $SYNCED nota(s) staged."
fi

exit 0
